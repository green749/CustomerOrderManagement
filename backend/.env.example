# ==============================================================
# Customer Order Management Agent - Environment Configuration
# ==============================================================

# Database: Neon PostgreSQL connection string
# Standard format: postgresql+psycopg://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@ep-cool-name-123456.region.aws.neon.tech/dbname?sslmode=require

# Read-only database connection string (optional, defaults to DATABASE_URL)
READONLY_DATABASE_URL=

# Application Environment (development, testing, production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security and JWT Configuration
# Generate a secure 32+ character key: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://manufacturing-agent.onrender.com

# Cookie Security (set to True in production with HTTPS)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_AI_WINDOW_SEC=60

# Domo AI Services Configuration
DOMO_SUBDOMAIN=your_domo_subdomain_here
DOMO_TOKEN=your_domo_developer_token_here
DOMO_MODEL=domo.domo_ai.domogpt-small-v2.1:anthropic

# Agent Execution Modes (agentic = Domo LLM tool calling, rules = deterministic fallback)
FEASIBILITY_AGENT_MODE=agentic
MONITORING_AGENT_MODE=agentic

# Data Directory for CSV imports (relative to backend folder or absolute)
DATA_DIR=../data/data

# Seed Users (Created automatically during seeding)
ADMIN_EMAIL=admin@manufacturing.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_FULL_NAME=System Administrator

DEMO_EMAIL=demo@manufacturing.com
DEMO_PASSWORD=your_secure_demo_password_here
DEMO_FULL_NAME=Demo Operations Manager

# SMTP Email Configuration for Agent 3 Alerts & Notifications
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use a 16-character Google App Password (not your personal password)
# For Outlook/Office365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# For zero-auth testing (e.g. YOPmail), you can leave SMTP_HOST blank or use a sandbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=Manufacturing 360 <your_email@gmail.com>

# ==============================================================
# Autonomous Multi-Agent Network - External Databases (STRICTLY READ-ONLY)
# ==============================================================
AGENT_01_PROD_PLANNING_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_03_OEE_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_07_ECM_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_08_TRACEABILITY_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_09_INVENTORY_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_10_SUPPLIER_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_12_LOGISTICS_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_13_ENERGY_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_14_EHS_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_16_COST_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_18_CUSTOMER_ORDER_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
VISION_AI_INSPECTION_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
AGENT_VISION_AI_DB_URL=postgresql://user:password@neon-host:5432/neondb?sslmode=require
